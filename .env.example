# ============================================================
# Comercializadora Chiquihuite — Mostrador & Chatbot (R1)
# Copia este archivo a .env.local y rellena los valores.
# ============================================================

# ---------- Supabase ----------
# URL del proyecto (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública anon (navegador / panel / Realtime)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Clave service role (SOLO servidor / webhook). NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---------- WhatsApp Cloud API ----------
# Token que configuras en el panel de Meta para verificar el webhook (GET)
WHATSAPP_VERIFY_TOKEN=un-token-secreto-de-verificacion
# Token de acceso de la Graph API (envío de mensajes / descarga de media)
WHATSAPP_ACCESS_TOKEN=tu-access-token
# ID del número de teléfono emisor
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id

# ---------- Desarrollo local ----------
# true  -> usa mocks de envío y descarga de archivos (no llama a la API real)
# false -> usa la WhatsApp Cloud API real
WHATSAPP_MOCK=true

# Nombre del bucket de Supabase Storage para adjuntos de WhatsApp
SUPABASE_STORAGE_BUCKET=adjuntos-whatsapp
